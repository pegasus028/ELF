{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elf-content.schema.json",
  "title": "ELF Studio content pack (EN33207, HANDOVER §4 contract)",
  "description": "Phase 1 rooms. Later phases add keys under rooms and rooms.exitChecks only. Midterm items are never in this file.",
  "type": "object",
  "required": ["meta", "settings", "groups", "professions", "rooms", "uiText"],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "lessonKey": { "type": "string", "pattern": "^L\\d{2}$" },
    "scaleItem": {
      "type": "object", "required": ["value", "label"],
      "properties": { "value": { "type": "integer", "minimum": 1, "maximum": 4 }, "label": { "$ref": "#/$defs/text" } }
    },
    "mcq": {
      "type": "object", "required": ["id", "options", "answer"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "type": { "const": "mcq" },
        "prompt": { "$ref": "#/$defs/text" }, "stem": { "$ref": "#/$defs/text" },
        "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/text" } },
        "answer": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 5 }, { "$ref": "#/$defs/text" }] },
        "explain": { "type": "string" }, "why": { "type": "string" }
      },
      "anyOf": [{ "required": ["prompt"] }, { "required": ["stem"] }]
    },
    "cloze": {
      "type": "object", "required": ["id", "type", "answer"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "type": { "const": "cloze" },
        "prompt": { "type": "string", "pattern": "___" }, "stem": { "type": "string", "pattern": "___" },
        "answer": { "$ref": "#/$defs/text" },
        "accept": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "explain": { "type": "string" }, "why": { "type": "string" }
      },
      "not": { "required": ["options"] },
      "anyOf": [{ "required": ["prompt"] }, { "required": ["stem"] }]
    },
    "nameOrObject": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "type": "object", "anyOf": [{ "required": ["text"] }, { "required": ["question"] }, { "required": ["label"] }] }
      ]
    }
  },
  "properties": {
    "meta": {
      "type": "object", "required": ["version", "course", "issued"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "course": { "const": "EN33207" },
        "issued": { "type": "string", "format": "date" },
        "dataStatus": { "type": "string" }
      }
    },
    "settings": {
      "type": "object", "required": ["lessonMinutes", "ratingScale", "pitchClock"],
      "properties": {
        "lessonMinutes": { "type": "integer", "minimum": 30, "maximum": 120 },
        "ratingScale": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/scaleItem" } },
        "pitchClock": {
          "type": "object", "required": ["pitch", "rate", "rotations"],
          "properties": {
            "pitch": { "type": "integer", "minimum": 15, "maximum": 180 },
            "rate": { "type": "integer", "minimum": 15, "maximum": 180 },
            "rotations": { "type": "integer", "minimum": 2, "maximum": 6 }
          }
        }
      }
    },
    "groups": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "required": ["id", "profession", "label"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 10 },
          "profession": { "enum": ["business", "medicine", "dentistry", "veterinary", "engineering", "accounting", "design", "humanities"] },
          "label": { "$ref": "#/$defs/text" },
          "size": { "type": "integer", "minimum": 2, "maximum": 4 }
        }
      }
    },
    "professions": {
      "type": "object",
      "required": ["business", "medicine", "dentistry", "veterinary", "engineering", "accounting", "design", "humanities"],
      "additionalProperties": {
        "type": "object", "required": ["label", "words"],
        "properties": {
          "label": { "$ref": "#/$defs/text" },
          "words": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "$ref": "#/$defs/text" } },
          "taboo": { "type": "object", "additionalProperties": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/text" } } }
        }
      }
    },
    "rooms": {
      "type": "object",
      "required": ["evidenceAudit", "lineUpgrader", "clicheHunter", "peerReview", "pitchClock", "questionCards", "exitChecks"],
      "properties": {
        "evidenceAudit": {
          "type": "object", "required": ["evidenceTypes", "flags"],
          "properties": {
            "rows": { "type": "integer", "minimum": 4, "maximum": 12 },
            "evidenceTypes": {
              "type": "array", "minItems": 3,
              "items": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "object", "required": ["label"], "anyOf": [{ "required": ["id"] }, { "required": ["key"] }] }] },
              "contains": { "oneOf": [{ "type": "string", "pattern": "^[Nn]one" }, { "type": "object", "anyOf": [{ "properties": { "key": { "const": "none" } }, "required": ["key"] }, { "properties": { "id": { "const": "none" } }, "required": ["id"] }, { "properties": { "verifiable": { "const": false } }, "required": ["verifiable"] }] }] }
            },
            "flags": {
              "type": "object", "required": ["unverifiable", "noScale"],
              "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "object", "required": ["label", "message"] }] }
            },
            "fields": { "type": "array", "items": { "type": "object", "required": ["key", "label"] } }
          }
        },
        "lineUpgrader": {
          "type": "object", "required": ["verbBank", "lines"],
          "properties": {
            "verbBank": { "type": "array", "minItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
            "lines": {
              "type": "array", "minItems": 20, "maxItems": 40,
              "items": {
                "type": "object", "required": ["id", "weak", "model", "slots"],
                "properties": {
                  "id": { "type": "string", "pattern": "^wl-\\d{2}$" },
                  "weak": { "$ref": "#/$defs/text" }, "model": { "$ref": "#/$defs/text" },
                  "slots": { "type": "array", "items": { "enum": ["verb", "number", "result"] } },
                  "profession": { "type": "string" }, "round": { "type": "integer", "minimum": 1, "maximum": 4 }
                }
              }
            },
            "rounds": { "type": "integer", "minimum": 1, "maximum": 4 },
            "linesPerRound": { "type": "integer", "minimum": 1, "maximum": 5 },
            "check": {
              "type": "object",
              "properties": { "numberPattern": { "type": "string" }, "resultMarkers": { "type": "array", "items": { "$ref": "#/$defs/text" } } }
            },
            "peerRatingScale": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "required": ["value", "label"] } }
          }
        },
        "clicheHunter": {
          "type": "object", "required": ["banList", "text"],
          "properties": {
            "banList": {
              "type": "array", "minItems": 10,
              "items": {
                "type": "object", "required": ["cliche", "replacement"],
                "properties": {
                  "id": { "type": "string" }, "cliche": { "$ref": "#/$defs/text" }, "replacement": { "$ref": "#/$defs/text" },
                  "patterns": { "type": "array", "items": { "$ref": "#/$defs/text" } }
                }
              }
            },
            "text": {
              "type": "object", "required": ["body", "spans"],
              "properties": {
                "title": { "type": "string" },
                "body": { "type": "string", "minLength": 200 },
                "spans": {
                  "type": "array", "minItems": 10, "maxItems": 10,
                  "items": {
                    "type": "array", "minItems": 3, "maxItems": 3,
                    "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 1 }, { "oneOf": [{ "type": "string" }, { "type": "integer" }] }]
                  }
                }
              }
            },
            "rewritesRequired": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "peerReview": {
          "type": "object", "required": ["questions"],
          "properties": { "questions": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/nameOrObject" } } }
        },
        "pitchClock": {
          "type": "object", "required": ["criteria", "frame"],
          "properties": {
            "criteria": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "items": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "object", "required": ["label"], "properties": { "levels": { "type": "array", "minItems": 4, "maxItems": 4 }, "anchors": { "type": "array", "minItems": 4, "maxItems": 4 } } }] }
            },
            "frame": { "type": "array", "minItems": 2 },
            "models": { "type": "array" }
          }
        },
        "questionCards": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/nameOrObject" } },
        "exitChecks": {
          "type": "object",
          "required": ["L09", "L10", "L11", "L12", "L13"],
          "propertyNames": { "$ref": "#/$defs/lessonKey" },
          "additionalProperties": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "oneOf": [{ "$ref": "#/$defs/mcq" }, { "$ref": "#/$defs/cloze" }] } }
        }
      }
    },
    "uiText": { "type": "object" }
  }
}
